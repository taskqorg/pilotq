+// Candidate-only validation seam: shared by Forward and the no-session harness.
+// Sherpa-onnx Apache-2.0; experiment #344, never installed.
+#ifndef SHERPA_ONNX_CSRC_GIGA344_VALIDATION_H_
+#define SHERPA_ONNX_CSRC_GIGA344_VALIDATION_H_
+#include <cmath>
+#include <cstdint>
+#include <stdexcept>
+#include <vector>
+#include "onnxruntime_cxx_api.h"
+namespace sherpa_onnx { namespace giga344 {
+inline std::vector<int64_t> Input(const Ort::Value &features,
+                                 const Ort::Value &features_length) {
+    if (!features.IsTensor() || !features_length.IsTensor())
+      throw std::runtime_error("giga344 requires feature tensors");
+    const auto shape = features_length.GetTensorTypeAndShapeInfo().GetShape();
+    const auto f_info = features.GetTensorTypeAndShapeInfo();
+    const auto f_shape = f_info.GetShape();
+    if (features_length.GetTensorTypeAndShapeInfo().GetElementType() !=
+            ONNX_TENSOR_ELEMENT_DATA_TYPE_INT64 ||
+        shape.size() != 1 || shape[0] <= 0 ||
+        f_info.GetElementType() != ONNX_TENSOR_ELEMENT_DATA_TYPE_FLOAT ||
+        f_shape.size() != 3 || f_shape[0] != shape[0] ||
+        f_shape[1] <= 0 || f_shape[1] > 2499 || f_shape[2] != 64)
+      throw std::runtime_error("giga344 invalid feature input");
+    const auto *src = features_length.GetTensorData<int64_t>();
+    std::vector<int64_t> expected_lengths(shape[0]);
+    for (int64_t i=0; i<shape[0]; ++i) {
+      if (src[i] <= 0 || src[i] > f_shape[1])
+        throw std::runtime_error("giga344 invalid feature length");
+      expected_lengths[i] = (src[i] + 3) / 4;
+    }
+    return expected_lengths;
+}
+inline std::vector<int64_t> Output(const std::vector<Ort::Value> &out,
+    int64_t batch, int64_t padded_frames,
+    const std::vector<int64_t> &expected_lengths) {
+    if (batch <= 0 || padded_frames <= 0 || padded_frames > 2499 ||
+        expected_lengths.size() != static_cast<size_t>(batch))
+      throw std::runtime_error("giga344 invalid validation context");
+    if (out.size() != 2 || !out[0].IsTensor() || !out[1].IsTensor())
+      throw std::runtime_error("giga344 missing output tensors");
+    const auto p_info = out[0].GetTensorTypeAndShapeInfo();
+    const auto p_shape = p_info.GetShape();
+    const auto l_info = out[1].GetTensorTypeAndShapeInfo();
+    if (p_info.GetElementType() != ONNX_TENSOR_ELEMENT_DATA_TYPE_FLOAT ||
+        p_shape.size() != 3 || p_shape[0] != batch ||
+        p_shape[1] != (padded_frames + 3) / 4 || p_shape[2] != 71 ||
+        l_info.GetElementType() != ONNX_TENSOR_ELEMENT_DATA_TYPE_INT32 ||
+        l_info.GetShape() != std::vector<int64_t>{batch})
+      throw std::runtime_error("giga344 invalid output shape/type");
+    const float *log_probs = out[0].GetTensorData<float>();
+    for (size_t i = 0; i != p_info.GetElementCount(); ++i) {
+      if (!std::isfinite(log_probs[i]))
+        throw std::runtime_error("giga344 nonfinite log probabilities");
+    }
+    const int32_t *encoded = out[1].GetTensorData<int32_t>();
+    std::vector<int64_t> lengths(batch);
+    for (int64_t i = 0; i != batch; ++i) {
+      if (encoded[i] <= 0 || encoded[i] != expected_lengths[i] || encoded[i] > p_shape[1])
+        throw std::runtime_error("giga344 invalid encoded length");
+      lengths[i] = encoded[i];  // Checked numeric conversion, never reinterpret.
+    }
+    return lengths;
+}
+}}  // namespace sherpa_onnx::giga344
+#endif
